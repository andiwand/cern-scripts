// Prototype: explicit vector width and output blocking; no Eigen in ISA kernels.
namespace {
template <unsigned Width, unsigned In, unsigned Out, class Layer>
ATH_ALWAYS_INLINE void dense(const Layer& layer, const float* input, float* output) {
  if constexpr (Out >= 16) {
    constexpr unsigned Blocks = std::min(unsigned(NN_BLOCKS), Out / Width);
    static_assert(Out % (Width * Blocks) == 0);
    using Vector = CxxUtils::vec<float, Width>;
    for (unsigned i = 0; i < Out; i += Width * Blocks) {
      Vector sums[Blocks]{};
      for (unsigned j = 0; j < In; ++j) {
#pragma GCC unroll 8
        for (unsigned k = 0; k < Blocks; ++k) {
          Vector weights;
          CxxUtils::vload(weights, layer.weights.data() + j * Out + i + k * Width);
          sums[k] += weights * input[j];
        }
      }
#pragma GCC unroll 8
      for (unsigned k = 0; k < Blocks; ++k) {
        Vector bias;
        CxxUtils::vload(bias, layer.bias.data() + i + k * Width);
        CxxUtils::vstore(output + i + k * Width, sums[k] + bias);
      }
    }
  } else {
    // Small heads have 3, 5, 10 or 15 outputs: no padding or overreads.
    std::fill_n(output, Out, 0.f);
    for (unsigned j = 0; j < In; ++j) {
      for (unsigned i = 0; i < Out; ++i) {
        output[i] += layer.weights[j * Out + i] * input[j];
      }
    }
    for (unsigned i = 0; i < Out; ++i) output[i] += layer.bias[i];
  }
}
}  // namespace
