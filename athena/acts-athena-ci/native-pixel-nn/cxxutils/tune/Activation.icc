// Public Eigen array API, with different types for the two ISA implementations.
// The vector width is part of every array expression's type and template name.
namespace {
template <unsigned Width, unsigned N>
ATH_ALWAYS_INLINE void packetSilu(float* x) {
  static_assert(N % Width == 0);
  using Array = Eigen::Array<float, Width, 1>;
#ifdef NN_UNROLL_ACTIVATION
#pragma GCC unroll 4
#endif
  for (unsigned i = 0; i < N; i += Width) {
    Eigen::Map<Array> value(x + i);
    const Array e = (-value.abs()).exp();
#ifdef NN_CXX_ACTIVATION
    // Eigen 3.4's Select evaluator is scalar; keep the blend/divide explicitly SIMD.
    using Vector = CxxUtils::vec<float, Width>;
    Vector v, exponential, numerator;
    CxxUtils::vload(v, x + i);
    CxxUtils::vload(exponential, e.data());
    CxxUtils::vselect(numerator, Vector{} + 1.f, exponential, v >= 0.f);
    CxxUtils::vstore(x + i, v * (numerator / (1.f + exponential)));
#else
    value *= (value >= 0).select(Array::Ones(), e) / (1.f + e);
#endif
  }
}
}  // namespace
