+// Throwaway CKF trace for the GBTS seed split study: every non-forced surface visit and every branch-stopper decision
+#pragma once
+#include <vector>
+#include <utility>
+#include <cstdint>
+namespace xAOD { class UncalibratedMeasurement_v1; }
+namespace ActsTrk::detail::ckftrace {
+  struct Visit { int pass{0}; unsigned vol{0}, lay{0}; float r{0}, z{0}; float cut{0}, cutOut{0}; float sig0{0}, sig1{0};
+                 // per candidate: measurement, chi2, residual 0, residual 1
+                 std::vector<const void*> meas; std::vector<float> chi2, res0, res1;
+                 // predicted state on the surface
+                 unsigned long long geo{0}; float loc0{0}, loc1{0}, phi{0}, theta{0}, qop{0}, sPhi{0}, sTheta{0}, sQop{0}; };
+  struct State { float r{0}, z{0}; int type{0}; float chi2{0}; const void* meas{nullptr}; };   // type 0 meas, 1 outlier, 2 hole, 3 other
+  struct Stop { int pass{0}; int result{0}; unsigned nMeas{0}, nHoles{0}, nOut{0}; float pt{0}; std::vector<State> states; };
+  inline thread_local int pass = 0;
+  inline thread_local std::vector<Visit>* visits = nullptr;
+  inline thread_local std::vector<Stop>* stops = nullptr;
+}
