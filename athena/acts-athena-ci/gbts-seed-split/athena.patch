diff --git a/Tracking/Acts/ActsPatternRecognition/src/GbtsSplitDiagAlg.cxx b/Tracking/Acts/ActsPatternRecognition/src/GbtsSplitDiagAlg.cxx
new file mode 100644
index 00000000000..2afb4fbd45e
--- /dev/null
+++ b/Tracking/Acts/ActsPatternRecognition/src/GbtsSplitDiagAlg.cxx
@@ -0,0 +1,91 @@
+/*
+  Copyright (C) 2002-2026 CERN for the benefit of the ATLAS collaboration
+*/
+#include "GbtsSplitDiagAlg.h"
+#include "TruthUtils/MagicNumbers.h"
+#include <array>
+#include <cmath>
+#include <iomanip>
+
+namespace {
+// GraphBasedTrackSeeder::estimateCurvature (ACTS v48.5.0), 1/(2R) in 1/mm
+float curvature(const std::array<const xAOD::SpacePoint*, 3>& n) {
+  const float x0 = n[2]->x(), y0 = n[2]->y();
+  const float r0 = std::hypot(x0, y0);
+  const float cosA = x0 / r0, sinA = y0 / r0;
+  std::array<float, 2> u{}, v{};
+  for (int k = 0; k < 2; ++k) {
+    const float dx = n[k]->x() - x0, dy = n[k]->y() - y0;
+    const float r2Inv = 1.0f / (dx * dx + dy * dy);
+    u[k] = (dx * cosA + dy * sinA) * r2Inv;
+    v[k] = (-dx * sinA + dy * cosA) * r2Inv;
+  }
+  const float du = u[0] - u[1];
+  if (du == 0.f) return 0.f;
+  const float A = (v[0] - v[1]) / du;
+  const float B = v[1] - A * u[1];
+  return B / std::sqrt(1 + A * A);
+}
+}
+
+namespace ActsTrk {
+StatusCode GbtsSplitDiagAlg::initialize() {
+  ATH_CHECK(m_seedsKey.initialize());
+  ATH_CHECK(m_truthKey.initialize());
+  ATH_CHECK(m_destinyKey.initialize(!m_destinyKey.empty()));
+  m_out.open(m_outFile.value());
+  return StatusCode::SUCCESS;
+}
+StatusCode GbtsSplitDiagAlg::finalize() { m_out.close(); return StatusCode::SUCCESS; }
+
+StatusCode GbtsSplitDiagAlg::execute(const EventContext& ctx) const {
+  SG::ReadHandle<ActsTrk::SeedContainer> seeds(m_seedsKey, ctx);
+  SG::ReadHandle<ActsTrk::MeasurementToTruthParticleAssociation> truth(m_truthKey, ctx);
+  ATH_CHECK(seeds.isValid());
+  ATH_CHECK(truth.isValid());
+  const std::vector<int>* destiny = nullptr;
+  if (!m_destinyKey.empty()) {
+    SG::ReadHandle<std::vector<int>> dh(m_destinyKey, ctx);
+    ATH_CHECK(dh.isValid());
+    destiny = dh.cptr();
+  }
+  const auto ev = ctx.eventID().event_number();
+  std::lock_guard<std::mutex> lock(m_mutex);
+  m_out << std::setprecision(7);
+  for (std::size_t is = 0; is < seeds->size(); ++is) {
+    const ActsTrk::Seed seed = seeds->at(is);
+    const auto& sps = seed.sp();
+    const std::size_t n = sps.size();
+    const xAOD::SpacePoint* a = sps.front();
+    const xAOD::SpacePoint* b = sps.back();
+    const float dr = std::hypot(b->x(), b->y()) - std::hypot(a->x(), a->y());
+    const float eta = std::asinh((b->z() - a->z()) / dr);
+    if (std::abs(eta) > m_maxAbsEta) continue;
+    // S ev seedIdx n eta invR0 invR1 invR2   (three sub-triplets as in the ACTS split check; 0 if n<4)
+    std::array<float, 3> inv{0, 0, 0};
+    if (n >= 4) {
+      std::vector<const xAOD::SpacePoint*> d1(sps.begin() + 1, sps.end()), d2;
+      for (std::size_t k = 0; k < n; ++k) if (k != n / 2) d2.push_back(sps[k]);
+      inv[0] = curvature({sps[0], sps[n / 2], sps[n - 1]});
+      inv[1] = curvature({d1[0], d1[(n - 1) / 2], d1[n - 2]});
+      inv[2] = curvature({d2[0], d2[(n - 1) / 2], d2[n - 2]});
+    }
+    m_out << "S " << ev << ' ' << is << ' ' << n << ' ' << eta << ' ' << inv[0] << ' ' << inv[1] << ' ' << inv[2];
+    // per SP: r phi z | ncontrib uid pt eta (first contributor) [uid2]
+    for (const xAOD::SpacePoint* sp : sps) {
+      m_out << " | " << std::hypot(sp->x(), sp->y()) << ' ' << std::atan2(sp->y(), sp->x()) << ' ' << sp->z();
+      const xAOD::UncalibratedMeasurement* meas = sp->measurements().front();
+      const auto& tps = truth->at(meas->index());
+      m_out << ' ' << tps.size();
+      for (std::size_t k = 0; k < std::min<std::size_t>(tps.size(), 2); ++k) {
+        const xAOD::TruthParticle* tp = tps[k];
+        if (tp) m_out << ' ' << HepMC::uniqueID(tp) << ' ' << tp->pt() << ' ' << tp->eta();
+        else m_out << " -1 0 0";
+      }
+    }
+    // destiny: 0 unknown, 1 succeed, 2 duplicate, 3 failure, -1 not stored
+    m_out << " | D " << (destiny ? destiny->at(is) : -1) << '\n';
+  }
+  return StatusCode::SUCCESS;
+}
+}
diff --git a/Tracking/Acts/ActsPatternRecognition/src/GbtsSplitDiagAlg.h b/Tracking/Acts/ActsPatternRecognition/src/GbtsSplitDiagAlg.h
