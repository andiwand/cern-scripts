+// Throwaway: dump the measurements (and stored holes) of the legacy ITk tracks, for the GBTS seed split study
+#pragma once
+#include "AthenaBaseComps/AthReentrantAlgorithm.h"
+#include "StoreGate/ReadHandleKey.h"
+#include "TrkTrack/TrackCollection.h"
+#include <fstream>
+#include <mutex>
