@@ -0,0 +1,32 @@
+/*
+  Copyright (C) 2002-2026 CERN for the benefit of the ATLAS collaboration
+*/
+// Throwaway diagnostic: GBTS seed split check + space point truth, one line per seed.
+#ifndef ACTSTRK_GBTSSPLITDIAGALG_H
+#define ACTSTRK_GBTSSPLITDIAGALG_H
+
+#include "AthenaBaseComps/AthReentrantAlgorithm.h"
+#include "StoreGate/ReadHandleKey.h"
+#include "ActsEvent/SeedContainer.h"
+#include "ActsEvent/MeasurementToTruthParticleAssociation.h"
+#include <fstream>
+#include <mutex>
+
+namespace ActsTrk {
+class GbtsSplitDiagAlg final : public AthReentrantAlgorithm {
+ public:
+  using AthReentrantAlgorithm::AthReentrantAlgorithm;
+  virtual StatusCode initialize() override;
+  virtual StatusCode execute(const EventContext& ctx) const override;
+  virtual StatusCode finalize() override;
+ private:
+  SG::ReadHandleKey<ActsTrk::SeedContainer> m_seedsKey{this, "InputSeeds", "ActsPixelSeeds"};
+  SG::ReadHandleKey<ActsTrk::MeasurementToTruthParticleAssociation> m_truthKey{this, "PixelTruthAssociationMap", "ITkPixelClustersToTruthParticles"};
+  SG::ReadHandleKey<std::vector<int>> m_destinyKey{this, "SeedDestiny", "ActsPixelSeedsDestiny"};
+  Gaudi::Property<std::string> m_outFile{this, "OutputFile", "gbtssplit.txt"};
+  Gaudi::Property<float> m_maxAbsEta{this, "MaxAbsEta", 0.8};
+  mutable std::mutex m_mutex;
+  mutable std::ofstream m_out;
+};
+}
+#endif
diff --git a/Tracking/Acts/ActsPatternRecognition/src/LegacyTrackDumpAlg.cxx b/Tracking/Acts/ActsPatternRecognition/src/LegacyTrackDumpAlg.cxx
new file mode 100644
index 00000000000..d1d576da3f6
--- /dev/null
+++ b/Tracking/Acts/ActsPatternRecognition/src/LegacyTrackDumpAlg.cxx
@@ -0,0 +1,48 @@
+#include "src/LegacyTrackDumpAlg.h"
+#include "TrkTrack/Track.h"
+#include "TrkTrack/TrackStateOnSurface.h"
+#include "TrkRIO_OnTrack/RIO_OnTrack.h"
+#include "TrkPrepRawData/PrepRawData.h"
+#include "InDetPrepRawData/SiCluster.h"
+#include "TrkSurfaces/Surface.h"
+#include "TrkParameters/TrackParameters.h"
+#include <cmath>
+namespace ActsTrk {
+StatusCode LegacyTrackDumpAlg::initialize() {
+  ATH_CHECK(m_tracksKey.initialize());
+  m_out.open(m_file.value());
+  return StatusCode::SUCCESS;
+}
+StatusCode LegacyTrackDumpAlg::finalize() { m_out.close(); return StatusCode::SUCCESS; }
+StatusCode LegacyTrackDumpAlg::execute(const EventContext& ctx) const {
+  SG::ReadHandle<TrackCollection> h(m_tracksKey, ctx);
+  ATH_CHECK(h.isValid());
+  std::ostringstream o;
+  std::size_t it = 0;
+  for (const Trk::Track* t : *h) {
+    ++it;
+    const Trk::Perigee* per = t->perigeeParameters();
+    if (!per || std::abs(per->eta()) > m_maxAbsEta) continue;
+    o << "L " << ctx.eventID().event_number() << ' ' << it << ' ' << per->pT() << ' ' << per->eta();
+    for (const Trk::TrackStateOnSurface* ts : *t->trackStateOnSurfaces()) {
+      const bool meas = ts->type(Trk::TrackStateOnSurface::Measurement);
+      const bool outl = ts->type(Trk::TrackStateOnSurface::Outlier);
+      const bool hole = ts->type(Trk::TrackStateOnSurface::Hole);
+      if (meas || outl) {
+        const auto* rot = dynamic_cast<const Trk::RIO_OnTrack*>(ts->measurementOnTrack());
+        const auto* cl = rot ? dynamic_cast<const InDet::SiCluster*>(rot->prepRawData()) : nullptr;
+        if (!cl) continue;
+        const auto& g = cl->globalPosition();
+        o << " | " << (outl ? 'o' : 'm') << ' ' << g.x() << ' ' << g.y() << ' ' << g.z();
+      } else if (hole && ts->trackParameters()) {
+        const auto& g = ts->trackParameters()->position();
+        o << " | h " << g.x() << ' ' << g.y() << ' ' << g.z();
+      }
+    }
+    o << '\n';
+  }
+  std::lock_guard<std::mutex> lock(m_mutex);
+  m_out << o.str();
+  return StatusCode::SUCCESS;
+}
+}
