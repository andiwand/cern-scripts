+  f.actor.interact(slab, f.result);
+  BOOST_REQUIRE_EQUAL(f.actor.interactions.pointPaths.size(), 1u);
+  CHECK_CLOSE_ABS(f.actor.interactions.pointPaths[0], 7.25, 1e-7);
+  CHECK_CLOSE_ABS(f.result.particle.pathInX0(), 5., 1e-7);
+  CHECK_CLOSE_ABS(f.result.particle.pathInL0(), 7.5, 1e-7);
+  CHECK_CLOSE_ABS(f.result.l0Limit, 7.75, 1e-7);
+  f.actor.interact(slab, f.result);
+  BOOST_REQUIRE_EQUAL(f.actor.interactions.pointPaths.size(), 2u);
+  CHECK_CLOSE_ABS(f.actor.interactions.pointPaths[1], 7.75, 1e-7);
+  CHECK_CLOSE_ABS(f.result.particle.pathInL0(), 8., 1e-7);
+}
+
+BOOST_AUTO_TEST_CASE(CompetingPointInteractionsAndSlabExit) {
+  for (const double nuclearDistance : {0.125, 0.5}) {
+    Fixture<NoSurface> f(0_GeV, makeEmptySurface());
+    f.result.particle = f.actor.initialParticle;
+    const MaterialSlab slab(Material::fromMolarDensity(2_mm, 8_mm, 12., 6., 1.),
+                            4_mm);
+    f.actor.interactions.selection = {1., nuclearDistance, 4, 5};
+    f.actor.interactions.killPointLike = true;
+    f.actor.armPointLikeInteractions(f.result.particle, f.result);
+    f.actor.interact(slab, f.result);
+    BOOST_REQUIRE_EQUAL(f.actor.interactions.pointProcesses.size(), 1u);
+    BOOST_CHECK_EQUAL(f.actor.interactions.pointProcesses[0],
+                      nuclearDistance < 0.25 ? 5u : 4u);
+    BOOST_CHECK(!f.result.isAlive);
+  }
+  Fixture<NoSurface> f(0_GeV, makeEmptySurface());
+  f.result.particle = f.actor.initialParticle;
+  f.actor.interactions.selection = {inf, 1., 0, 1};
+  f.actor.armPointLikeInteractions(f.result.particle, f.result);
+  f.actor.interact(makeUnitSlab(), f.result);
+  BOOST_CHECK_EQUAL(f.actor.interactions.pointProcesses.size(), 1u);
+  BOOST_CHECK_EQUAL(f.result.generatedParticles.size(), 1u);
+  // Zero material must not execute another point-like interaction.
+  f.actor.interact(MaterialSlab(), f.result);
+  BOOST_CHECK_EQUAL(f.actor.interactions.pointProcesses.size(), 1u);
+}
+
 BOOST_AUTO_TEST_SUITE_END()
 
 }  // namespace ActsTests
