new file mode 100644
index 0000000000..a7b27c0524
--- /dev/null
+++ b/Tests/UnitTests/Fatras/Kernel/MultiParticleSimulationTests.cpp
@@ -0,0 +1,110 @@
+// This file is part of the ACTS project.
+//
+// Copyright (C) 2016 CERN for the benefit of the ACTS project
+//
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at https://mozilla.org/MPL/2.0/.
+
+#include <boost/test/unit_test.hpp>
+
+#include "ActsFatras/Kernel/MultiParticleSimulation.hpp"
+#include "ActsFatras/Selectors/KinematicCasts.hpp"
+#include "ActsFatras/Selectors/ParticleSelectors.hpp"
+#include "ActsFatras/Selectors/SelectorHelpers.hpp"
+
+#include <random>
+#include <system_error>
+#include <vector>
+
+namespace {
+
+struct FailingSecondarySimulation {
+  template <typename generator_t>
+  Acts::Result<ActsFatras::SingleParticleSimulationResult> simulate(
+      const Acts::GeometryContext&, const Acts::MagneticFieldContext&,
+      generator_t&, const ActsFatras::Particle& particle) const {
+    if (particle.absoluteMomentum() == 2.) {
+      return std::make_error_code(std::errc::invalid_argument);
+    }
+    ActsFatras::SingleParticleSimulationResult result;
+    result.particle = particle;
+    if (particle.particleId().generation() == 0 && particle.charge() != 0) {
+      for (unsigned int i = 0; i < 2; ++i) {
+        result.generatedParticles.push_back(
+            particle.withParticleId(particle.particleId().makeDescendant(i))
+                .setAbsoluteMomentum(2. + i));
+      }
+    }
+    return result;
+  }
+};
+
+}  // namespace
+
+BOOST_AUTO_TEST_CASE(FailedSecondaryPreservesIdentityAndSibling) {
+  using namespace ActsFatras;
+  MultiParticleSimulation<EveryParticle, FailingSecondarySimulation,
+                          EveryParticle, FailingSecondarySimulation>
+      simulation(FailingSecondarySimulation{}, FailingSecondarySimulation{});
+  const Particle parent(Barcode().withParticle(1),
+                        Acts::PdgParticle::ePionPlus);
+  const std::vector<Particle> input{Particle(parent).setAbsoluteMomentum(10.)};
+  std::vector<Particle> initial, final;
+  std::vector<Hit> hits;
+  std::ranlux48 generator(42);
+  const auto result = simulation.simulate(
+      Acts::GeometryContext::dangerouslyDefaultConstruct(),
+      Acts::MagneticFieldContext{}, generator, input, initial, final, hits);
+  BOOST_REQUIRE(result.ok());
+  BOOST_REQUIRE_EQUAL(result->size(), 1u);
+  BOOST_CHECK_EQUAL(result->front().particle.absoluteMomentum(), 2.);
+  BOOST_CHECK_EQUAL(result->front().particle.particleId(),
+                    parent.particleId().makeDescendant(0));
+  BOOST_CHECK(result->front().error == std::errc::invalid_argument);
+  BOOST_REQUIRE_EQUAL(initial.size(), 2u);
+  BOOST_REQUIRE_EQUAL(final.size(), 2u);
+  BOOST_CHECK_EQUAL(initial.back().absoluteMomentum(), 3.);
+  BOOST_CHECK_EQUAL(initial.back().particleId(),
+                    parent.particleId().makeDescendant(1));
+  BOOST_CHECK_EQUAL(final.back().particleId(), initial.back().particleId());
+}
+
+BOOST_AUTO_TEST_CASE(ChargedMomentumCutsApplyToPrimariesAndSecondaries) {
+  using namespace ActsFatras;
+  using CutP = Min<Casts::P>;
+  using CutPt = Min<Casts::Pt>;
+  MultiParticleSimulation<CombineAnd<CutP, CutPt>, FailingSecondarySimulation,
+                          CutP, FailingSecondarySimulation>
+      simulation(FailingSecondarySimulation{}, FailingSecondarySimulation{});
+  simulation.selectCharged.get<CutP>().valMin = 1.;
+  simulation.selectCharged.get<CutPt>().valMin = 2.5;
+  simulation.selectNeutral.valMin = 1.;
+  const Particle parent =
+      Particle(Barcode().withParticle(1), Acts::PdgParticle::ePionPlus)
+          .setAbsoluteMomentum(10.)
+          .setDirection(1, 0, 0);
+  const Particle forward =
+      Particle(Barcode().withParticle(2), Acts::PdgParticle::ePionPlus)
+          .setAbsoluteMomentum(10.)
+          .setDirection(0, 0, 1);
+  const Particle photon =
+      Particle(Barcode().withParticle(3), Acts::PdgParticle::eGamma)
+          .setAbsoluteMomentum(10.)
+          .setDirection(0, 0, 1);
+  std::vector<Particle> initial, final;
+  std::vector<Hit> hits;
+  std::ranlux48 generator(42);
+  const auto result = simulation.simulate(
+      Acts::GeometryContext::dangerouslyDefaultConstruct(),
+      Acts::MagneticFieldContext{}, generator,
+      std::vector<Particle>{parent, forward, photon}, initial, final, hits);
+  BOOST_REQUIRE(result.ok());
+  // The 2 GeV charged secondary was rejected before reaching the mock failure.
+  BOOST_CHECK(result->empty());
+  BOOST_REQUIRE_EQUAL(initial.size(), 3u);
+  BOOST_CHECK_EQUAL(initial[0].particleId(), parent.particleId());
+  BOOST_CHECK_EQUAL(initial[1].particleId(),
+                    parent.particleId().makeDescendant(1));
+  BOOST_CHECK_EQUAL(initial[2].particleId(), photon.particleId());
+}
