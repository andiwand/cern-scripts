+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at https://mozilla.org/MPL/2.0/.
+
+#include <boost/test/unit_test.hpp>
+
+#include "ActsFatras/Geant4/Geant4Decay.hpp"
+#include "ActsTests/CommonHelpers/FloatComparisons.hpp"
+
+#include <cmath>
+#include <future>
+#include <random>
+
+#include <CLHEP/Random/Random.h>
+
+using namespace Acts::UnitLiterals;
+
+BOOST_AUTO_TEST_CASE(Geant4DecayLifetimeAndEventRandomness) {
+  ActsFatras::Geant4Decay decay;
+  ActsFatras::Particle parent(ActsFatras::Barcode().withParticle(1),
+                              Acts::PdgParticle::ePionPlus);
+  parent.setAbsoluteMomentum(1_GeV).setProperTime(7_mm);
+  std::ranlux48 generator(42), expected(42);
+  std::uniform_real_distribution<double> uniform(0., 1.);
+  ActsFatras::PDGtoG4Converter converter;
+  const double meanLifetime =
+      converter.getParticleDefinition(parent.pdg())->GetPDGLifeTime() *
+      Acts::UnitConstants::s / CLHEP::s;
+  const double expectedLimit =
+      parent.properTime() - meanLifetime * std::log1p(-uniform(expected));
+  CHECK_CLOSE_REL(decay.generateProperTimeLimit(generator, parent),
+                  expectedLimit, 1e-12);
+  BOOST_CHECK(generator == expected);
+  BOOST_CHECK_GT(meanLifetime, 1_m);
+
+  const auto engine = CLHEP::HepRandom::getTheEngine();
+  const auto engineState = engine->put();
+  const auto daughters = decay.run(generator, parent);
+  const auto replay = decay.run(expected, parent);
+  BOOST_REQUIRE_EQUAL(daughters.size(), replay.size());
+  BOOST_REQUIRE(!daughters.empty());
+  Acts::Vector4 momentumSum = Acts::Vector4::Zero();
+  for (std::size_t i = 0; i < daughters.size(); ++i) {
+    BOOST_CHECK_EQUAL(daughters[i].pdg(), replay[i].pdg());
+    BOOST_CHECK_EQUAL(daughters[i].fourMomentum(), replay[i].fourMomentum());
+    BOOST_CHECK_EQUAL(daughters[i].fourPosition(), parent.fourPosition());
+    BOOST_CHECK_EQUAL(daughters[i].process(),
+                      ActsFatras::GenerationProcess::eDecay);
+    momentumSum += daughters[i].fourMomentum();
+  }
+  CHECK_CLOSE_ABS(momentumSum, parent.fourMomentum(), 1e-6);
+  BOOST_CHECK(generator == expected);
+  BOOST_CHECK(CLHEP::HepRandom::getTheEngine() == engine);
+  BOOST_CHECK(engine->put() == engineState);
+
+  // A shared decay module must reproduce the same event on different threads.
+  const auto simulate = [&decay, parent]() mutable {
+    std::ranlux48 rng(123);
+    return decay.run(rng, parent);
+  };
+  auto first = std::async(std::launch::async, simulate);
+  auto second = std::async(std::launch::async, simulate);
+  const auto a = first.get();
+  const auto b = second.get();
+  BOOST_REQUIRE_EQUAL(a.size(), b.size());
+  for (std::size_t i = 0; i < a.size(); ++i) {
+    BOOST_CHECK_EQUAL(a[i].fourMomentum(), b[i].fourMomentum());
+  }
+}
