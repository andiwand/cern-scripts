+BOOST_AUTO_TEST_CASE(NativeDecayVertexFollowsSampledLifetime) {
+  auto geoCtx = GeometryContext::dangerouslyDefaultConstruct();
+  MagneticFieldContext magCtx;
+  CylindricalTrackingGeometry builder(geoCtx);
+  auto geometry = builder();
+  using NS = SingleParticleSimulation<NeutralPropagator, InteractionList<>,
+                                      NoSurface, NativeDecay>;
+  NS simulation(NeutralPropagator(NeutralStepper(), Navigator({geometry})),
+                getDefaultLogger("NativeDecay", Logging::WARNING));
+  simulation.maxStepSize = 1_m;
+  simulation.pathLimit = 10_m;
+  for (auto pdg : {PdgParticle::eKaon0Short, PdgParticle::eLambda0,
+                    static_cast<PdgParticle>(-PdgParticle::eLambda0)}) {
+    std::size_t decayed = 0;
+    for (double p : {0.01_GeV, 0.1_GeV, 1_GeV, 10_GeV}) {
+      for (unsigned seed = 0; seed < 16; ++seed) {
+        Particle parent(Barcode().withParticle(1), pdg);
+        parent.setAbsoluteMomentum(p).setDirection(1, 0, 0)
+            .setPosition4(0, 0, 0, 5_mm).setProperTime(7_mm);
+        Generator rng(seed), reference(seed);
+        const double age = simulation.decay.generateProperTimeLimit(reference, parent);
+        const double elapsed = age - parent.properTime();
+        const double distance = elapsed * p / parent.mass();
+        const auto result = simulation.simulate(geoCtx, magCtx, rng, parent);
+        BOOST_REQUIRE(result.ok());
+        if (result->particle.outcome() != SimulationOutcome::Decayed) {
+          // World exit before the sampled decay must not produce daughters.
+          BOOST_CHECK(result->generatedParticles.empty());
+          BOOST_CHECK_LT(result->particle.position().norm(), distance);
+          continue;
+        }
+        ++decayed;
+        BOOST_CHECK(!result->isAlive);
+        CHECK_CLOSE_ABS(result->particle.position(), Vector3(distance, 0, 0), 1e-6);
+        CHECK_CLOSE_ABS(result->particle.properTime(), age, 1e-6);
+        CHECK_CLOSE_ABS(result->particle.time(),
+                         parent.time() + elapsed * parent.energy() / parent.mass(), 1e-6);
+        BOOST_REQUIRE_EQUAL(result->generatedParticles.size(), 2u);
+        for (const auto& daughter : result->generatedParticles) {
+          BOOST_CHECK_EQUAL(daughter.fourPosition(), result->particle.fourPosition());
+        }
+      }
+    }
+    BOOST_CHECK_GT(decayed, 32u);
+  }
+}
+
+BOOST_AUTO_TEST_CASE(NativeDecayCascadeTruthAndSecondaryHits) {
+  auto geoCtx = GeometryContext::dangerouslyDefaultConstruct();
+  MagneticFieldContext magCtx;
+  CylindricalTrackingGeometry builder(geoCtx);
+  auto geometry = builder();
+  using Cut = Min<Casts::P>;
+  using CS = SingleParticleSimulation<ChargedPropagator, InteractionList<>,
+                                      EverySurface, NoDecay, Cut>;
+  using NS = SingleParticleSimulation<NeutralPropagator, InteractionList<>,
+                                      NoSurface, NativeDecay>;
+  using SelectNeutral = DecayParticleSelector<NativeDecay, Cut>;
+  auto field = std::make_shared<ConstantBField>(Vector3::Zero());
+  MultiParticleSimulation<Cut, CS, SelectNeutral, NS> simulation(
+      CS(ChargedPropagator(ChargedStepper(field), Navigator({geometry})),
+         getDefaultLogger("Charged", Logging::WARNING)),
+      NS(NeutralPropagator(NeutralStepper(), Navigator({geometry})),
+         getDefaultLogger("Neutral", Logging::WARNING)));
+  simulation.selectCharged.valMin = 50_MeV;
+  simulation.charged.selectParticle = simulation.selectCharged;
+  simulation.selectNeutral.selectStable.valMin = 50_MeV;
+  simulation.charged.pathLimit = 2_m;
+  simulation.neutral.pathLimit = 2_m;
+  std::vector<Particle> input;
+  for (std::size_t i = 1; i <= 120; ++i) {
+    const std::array pdgs{PdgParticle::eKaon0Short, PdgParticle::eLambda0,
+                          static_cast<PdgParticle>(-PdgParticle::eLambda0)};
+    input.push_back(Particle(Barcode().withParticle(i), pdgs[i % 3])
+        .setDirection(1, 0, 0).setAbsoluteMomentum(1_MeV));
+  }
+  std::vector<Particle> initial, final;
+  std::vector<Hit> hits;
+  Generator rng(42);
+  const auto result = simulation.simulate(geoCtx, magCtx, rng, input, initial, final, hits);
+  BOOST_REQUIRE(result.ok());
+  BOOST_REQUIRE(result->empty());
+  BOOST_CHECK_GT(hits.size(), 0u);
+  BOOST_CHECK_EQUAL(initial.size(), final.size());
+  std::size_t pions = 0, cascadePhotons = 0;
+  for (std::size_t i = 0; i < initial.size(); ++i) {
+    const auto& particle = initial[i];
+    if (particle.particleId().generation() == 0) {
+      BOOST_CHECK_EQUAL(final[i].outcome(), SimulationOutcome::Decayed);
+    } else {
+      const auto parent = std::find_if(final.begin(), final.end(), [&](const auto& p) {
+        return p.particleId() == particle.parentParticleId();
+      });
+      BOOST_REQUIRE(parent != final.end());
+      BOOST_CHECK_EQUAL(particle.fourPosition(), parent->fourPosition());
+      BOOST_CHECK_EQUAL(particle.process(), GenerationProcess::eDecay);
+    }
+    if (particle.pdg() == PdgParticle::ePionZero) {
+      ++pions;
+      BOOST_CHECK_EQUAL(final[i].outcome(), SimulationOutcome::Decayed);
+      BOOST_CHECK_EQUAL(final[i].fourPosition(), particle.fourPosition());
+    }
+    cascadePhotons += particle.pdg() == PdgParticle::eGamma &&
+                      particle.particleId().generation() == 2;
+  }
+  BOOST_CHECK_GT(pions, 0u);
+  BOOST_CHECK_GT(cascadePhotons, 0u);
+  sortByParticleId(initial);
+  BOOST_CHECK(areParticleIdsUnique(initial));
+  for (const auto& hit : hits) {
+    BOOST_CHECK_GT(hit.particleId().generation(), 0u);
+    BOOST_CHECK(containsParticleId(initial, hit));
+  }
+}
