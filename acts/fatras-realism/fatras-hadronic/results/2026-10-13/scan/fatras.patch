+
+ActsFatras::StandardChargedInteractions
+ActsFatras::makeStandardChargedInteractions(
+    double minimumAbsMomentum,
+    std::shared_ptr<const NuclearInteractionTable> nuclearTable) {
+  auto em = makeStandardChargedElectroMagneticInteractions(minimumAbsMomentum);
+  StandardChargedInteractions interactions;
+  interactions.get<detail::StandardScattering>() =
+      em.get<detail::StandardScattering>();
+  interactions.get<detail::StandardBetheBloch>() =
+      em.get<detail::StandardBetheBloch>();
+  interactions.get<detail::StandardBetheHeitler>() =
+      em.get<detail::StandardBetheHeitler>();
+  interactions.get<NuclearInteraction>().table = std::move(nuclearTable);
+  return interactions;
+}
