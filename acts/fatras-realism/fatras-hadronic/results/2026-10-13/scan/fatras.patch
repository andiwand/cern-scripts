+/// Standard charged EM processes followed by optional inelastic interactions.
+/// Nuclear interactions use a supplied calibration; no table means EM only.
+using StandardChargedInteractions =
+    InteractionList<detail::StandardScattering, detail::StandardBetheBloch,
+                    detail::StandardBetheHeitler, NuclearInteraction>;
+
+/// Construct charged physics with an optional hadronic calibration.
+/// @param minimumAbsMomentum lower p cut on output particles
+/// @param nuclearTable immutable hadronic calibration, or null to disable
+/// @return Configured interaction list
+StandardChargedInteractions makeStandardChargedInteractions(
+    double minimumAbsMomentum,
+    std::shared_ptr<const NuclearInteractionTable> nuclearTable = nullptr);
+
 /// Standard set of electro-magnetic interactions for neutral particles.
