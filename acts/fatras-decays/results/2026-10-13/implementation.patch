diff --git a/Fatras/include/ActsFatras/Physics/Decay/NativeDecay.hpp b/Fatras/include/ActsFatras/Physics/Decay/NativeDecay.hpp
new file mode 100644
index 0000000000..37031b7f97
--- /dev/null
+++ b/Fatras/include/ActsFatras/Physics/Decay/NativeDecay.hpp
@@ -0,0 +1,87 @@
+// This file is part of the ACTS project.
+//
+// Copyright (C) 2016 CERN for the benefit of the ACTS project
+//
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at https://mozilla.org/MPL/2.0/.
+
+#pragma once
+
+#include "ActsFatras/EventData/Particle.hpp"
+
+#include <cmath>
+#include <limits>
+#include <numbers>
+#include <random>
+#include <vector>
+
+namespace ActsFatras {
+
+/// Lightweight neutral decays without an external physics library.
+///
+/// Models K-short -> pi+ pi-/pi0 pi0, Lambda -> p pi-/n pi0 and their
+/// charge conjugates, with PDG 2026 lifetimes and relative channel weights.
+/// Rare channels are omitted and the retained weights normalized. Lambda
+/// decays are unpolarized. Pi0 -> gamma gamma is prompt and exclusive.
+/// All other species are stable. See docs/pages/fatras_decays.md.
+struct NativeDecay {
+  /// Disable all channels without consuming random numbers.
+  bool enabled = true;
+
+  /// Whether this particle can decay with the current configuration.
+  /// @param particle Parent particle
+  /// @return True for a live, supported particle when enabled
+  bool canDecay(const Particle& particle) const;
+
+  /// Mean lifetime in ACTS proper-time units (c*time).
+  /// @param pdg Particle species
+  /// @return Zero for prompt pi0, infinity for unsupported species
+  static double meanProperLifetime(Acts::PdgParticle pdg);
+
+  /// Sample the accumulated proper time at decay, including the initial age.
+  /// @param generator Event random engine
+  /// @param particle Parent particle
+  /// @return Accumulated lifetime limit, or infinity if disabled/unsupported
+  template <typename generator_t>
+  double generateProperTimeLimit(generator_t& generator,
+                                 const Particle& particle) const {
+    if (!canDecay(particle)) {
+      return std::numeric_limits<double>::infinity();
+    }
+    const double mean = meanProperLifetime(particle.pdg());
+    if (mean == 0) {
+      return particle.properTime();
+    }
+    std::uniform_real_distribution<double> uniform(0, 1);
+    return particle.properTime() - mean * std::log1p(-uniform(generator));
+  }
+
+  /// Generate two daughters at the parent position without modifying the
+  /// parent. The simulation actor records the parent's Decayed outcome. Pi0
+  /// daughters remain explicit particles, so recursive transport preserves
+  /// their ancestry.
+  /// @param generator Event random engine
+  /// @param particle Parent particle at its decay vertex
+  /// @return Daughters, or an empty vector if disabled/unsupported
+  template <typename generator_t>
+  std::vector<Particle> run(generator_t& generator,
+                            const Particle& particle) const {
+    if (!canDecay(particle)) {
+      return {};
+    }
+    std::uniform_real_distribution<double> uniform(0, 1);
+    // Draw in explicit order, independent of argument evaluation order.
+    const double channel =
+        particle.pdg() == Acts::PdgParticle::ePionZero ? 0 : uniform(generator);
+    const double cosTheta = 2 * uniform(generator) - 1;
+    const double phi = 2 * std::numbers::pi * uniform(generator);
+    return daughters(particle, channel, cosTheta, phi);
+  }
+
+ private:
+  static std::vector<Particle> daughters(const Particle& parent, double channel,
+                                         double cosTheta, double phi);
+};
+
+}  // namespace ActsFatras
