+BOOST_AUTO_TEST_CASE(DecayParentAcceptance) {
+  DecayParticleSelector<NativeDecay, Min<Casts::P>> select;
+  select.selectStable.valMin = 0.5_GeV;
+  for (const auto pdg : species) {
+    Particle parent(Barcode().withParticle(1), pdg);
+    parent.setAbsoluteMomentum(1_MeV);
+    BOOST_CHECK(select(parent));
+    select.decay.enabled = false;
+    BOOST_CHECK(!select(parent));
+    select.decay.enabled = true;
