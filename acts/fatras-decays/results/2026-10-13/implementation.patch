diff --git a/Fatras/src/Physics/TwoBodyDecay.cpp b/Fatras/src/Physics/TwoBodyDecay.cpp
new file mode 100644
index 0000000000..b3dbc62754
--- /dev/null
+++ b/Fatras/src/Physics/TwoBodyDecay.cpp
@@ -0,0 +1,47 @@
+// This file is part of the ACTS project.
+//
+// Copyright (C) 2016 CERN for the benefit of the ACTS project
+//
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at https://mozilla.org/MPL/2.0/.
+
+#include "ActsFatras/Physics/Decay/TwoBodyDecay.hpp"
+
+#include <cmath>
+#include <stdexcept>
+
+namespace ActsFatras {
+
+std::array<Acts::Vector3, 2> twoBodyDecay(
+    const Acts::Vector3& momentum, double mass,
+    const std::array<double, 2>& daughterMasses, double cosTheta, double phi) {
+  const auto [m0, m1] = daughterMasses;
+  if (!momentum.allFinite() || !std::isfinite(mass) || mass <= 0 ||
+      !std::isfinite(m0) || !std::isfinite(m1) || m0 < 0 || m1 < 0 ||
+      mass < m0 + m1 || !std::isfinite(cosTheta) || std::abs(cosTheta) > 1 ||
+      !std::isfinite(phi)) {
+    throw std::invalid_argument("Invalid two-body decay kinematics");
+  }
+  const double sum = m0 + m1;
+  const double diff = m0 - m1;
+  const double q =
+      std::sqrt((mass - sum) * (mass + sum) * (mass - diff) * (mass + diff)) /
+      (2 * mass);
+  const double sinTheta = std::sqrt((1 - cosTheta) * (1 + cosTheta));
+  const Acts::Vector3 rest =
+      q * Acts::Vector3(sinTheta * std::cos(phi), sinTheta * std::sin(phi),
+                        cosTheta);
+  // Work with gamma*beta directly, avoiding 1-beta^2 at large boosts.
+  const Acts::Vector3 u = momentum / mass;
+  const double gamma = std::hypot(mass, momentum.norm()) / mass;
+  std::array<Acts::Vector3, 2> daughters;
+  for (std::size_t i = 0; i < daughters.size(); ++i) {
+    const Acts::Vector3 p = i == 0 ? rest : Acts::Vector3(-rest);
+    const double energy = std::hypot(q, daughterMasses[i]);
+    daughters[i] = p + u * (energy + u.dot(p) / (gamma + 1));
+  }
+  return daughters;
+}
+
+}  // namespace ActsFatras
