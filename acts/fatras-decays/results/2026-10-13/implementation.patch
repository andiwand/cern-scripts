+BOOST_AUTO_TEST_CASE(NativeDecayBoostTruthAndReplay) {
+  const NativeDecay decay;
+  for (const auto pdg : {PdgParticle::eKaon0Short, PdgParticle::eLambda0,
+                         antiLambda, PdgParticle::ePionZero}) {
+    Particle parent(Barcode().withVertexPrimary(42).withParticle(1), pdg);
+    parent.setDirection(1, -2, 3)
+        .setAbsoluteMomentum(100_GeV)
+        .setPosition4(3_mm, -5_mm, 7_mm, 10_mm)
+        .setProperTime(4_mm);
+    auto simulate = [&decay, parent]() {
+      std::mt19937_64 rng(123);
+      return decay.run(rng, parent);
+    };
+    auto future = std::async(std::launch::async, simulate);
+    const auto daughters = simulate();
+    const auto replay = future.get();
+    Vector4 sum = Vector4::Zero();
+    for (std::size_t i = 0; i < daughters.size(); ++i) {
+      const auto& d = daughters[i];
+      BOOST_CHECK_EQUAL(d.pdg(), replay[i].pdg());
+      BOOST_CHECK_EQUAL(d.fourMomentum(), replay[i].fourMomentum());
+      BOOST_CHECK_EQUAL(d.parentParticleId(), parent.particleId());
+      BOOST_CHECK_EQUAL(d.fourPosition(), parent.fourPosition());
+      BOOST_CHECK_EQUAL(d.particleId(), parent.particleId().makeDescendant(i));
+      BOOST_CHECK_EQUAL(d.properTime(), 0.);
+      BOOST_CHECK_EQUAL(d.process(), GenerationProcess::eDecay);
+      sum += d.fourMomentum();
+    }
+    CHECK_CLOSE_ABS(sum, parent.fourMomentum(), 1e-10);
+  }
+}
