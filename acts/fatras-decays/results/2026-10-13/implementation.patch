@@ -0,0 +1,35 @@
+// This file is part of the ACTS project.
+//
+// Copyright (C) 2016 CERN for the benefit of the ACTS project
+//
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at https://mozilla.org/MPL/2.0/.
+
+#pragma once
+
+#include "ActsFatras/EventData/Particle.hpp"
+
+namespace ActsFatras {
+
+/// Preserve decay parents independently of cuts on stable particles.
+/// A slow parent can produce daughters above the transport threshold.
+/// Exact rest particles cannot use the track propagator and are excluded.
+/// @tparam decay_t Decay module providing canDecay(particle)
+/// @tparam selector_t Selector for particles without a modeled decay
+template <typename decay_t, typename selector_t>
+struct DecayParticleSelector {
+  /// Decay policy; must match the policy used by the simulator.
+  decay_t decay;
+  /// Acceptance for all other particles.
+  selector_t selectStable;
+
+  /// @param particle Particle to select
+  /// @return Whether the particle should be transported
+  bool operator()(const Particle& particle) const {
+    return particle.absoluteMomentum() > 0 &&
+           (decay.canDecay(particle) || selectStable(particle));
+  }
+};
+
+}  // namespace ActsFatras
