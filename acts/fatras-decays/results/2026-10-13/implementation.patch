+BOOST_AUTO_TEST_CASE(NativeDecayDisabledStableAndPrompt) {
+  NativeDecay decay;
+  std::mt19937_64 rng(42), untouched(42);
+  for (const auto pdg : {PdgParticle::eProton, PdgParticle::eKaonPlus,
+                         PdgParticle::eGamma, PdgParticle::eMuon}) {
+    Particle p(Barcode().withParticle(1), pdg);
+    BOOST_CHECK(std::isinf(decay.generateProperTimeLimit(rng, p)));
+    BOOST_CHECK(decay.run(rng, p).empty());
+  }
+  Particle pion(Barcode().withParticle(1), PdgParticle::ePionZero);
+  pion.setProperTime(3_mm);
+  BOOST_CHECK_EQUAL(decay.generateProperTimeLimit(rng, pion), 3_mm);
+  BOOST_CHECK(rng == untouched);
+  decay.enabled = false;
+  for (const auto pdg : species) {
+    Particle p(Barcode().withParticle(1), pdg);
+    BOOST_CHECK(std::isinf(decay.generateProperTimeLimit(rng, p)));
+    BOOST_CHECK(decay.run(rng, p).empty());
+  }
+  BOOST_CHECK(rng == untouched);
+  decay.enabled = true;
+  pion.killParticle(SimulationOutcome::Decayed);
+  BOOST_CHECK(!decay.canDecay(pion));
+}
