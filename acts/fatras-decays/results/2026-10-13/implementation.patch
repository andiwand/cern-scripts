+BOOST_AUTO_TEST_CASE(TwoBodyConservationAndThresholds) {
+  for (double p : {0., 1e-9, 1., 1e4}) {
+    const Vector3 momentum = p * Vector3(1, -2, 3).normalized();
+    for (const auto masses :
+         {std::array{0., 0.}, std::array{0.2, 0.3}, std::array{0.4, 0.6}}) {
+      for (double cosine : {-1., -0.3, 0., 1.}) {
+        const auto daughters = twoBodyDecay(momentum, 1., masses, cosine, 1.7);
+        CHECK_CLOSE_ABS(daughters[0] + daughters[1], momentum, 1e-10);
+        const double energy = std::hypot(masses[0], daughters[0].norm()) +
+                              std::hypot(masses[1], daughters[1].norm());
+        CHECK_CLOSE_REL(energy, std::hypot(1., p), 1e-12);
+      }
+    }
+  }
+  const auto atRest = twoBodyDecay(Vector3::Zero(), 1., {0.2, 0.3}, 1., 0.);
+  CHECK_CLOSE_REL(std::hypot(0.2, atRest[0].norm()),
+                  (1 + 0.2 * 0.2 - 0.3 * 0.3) / 2, 1e-12);
+  BOOST_CHECK_THROW(twoBodyDecay(Vector3::Zero(), 0., {0., 0.}, 0., 0.),
+                    std::invalid_argument);
+  BOOST_CHECK_THROW(twoBodyDecay(Vector3::Zero(), 1., {0.6, 0.6}, 0., 0.),
+                    std::invalid_argument);
+  BOOST_CHECK_THROW(twoBodyDecay(Vector3::Zero(), 1., {-0.1, 0.}, 0., 0.),
+                    std::invalid_argument);
+  BOOST_CHECK_THROW(twoBodyDecay(Vector3::Zero(), 1., {0., 0.}, 1.1, 0.),
+                    std::invalid_argument);
+}
+
+BOOST_AUTO_TEST_CASE(NativeDecayLifetimeDistribution) {
+  NativeDecay decay;
+  std::mt19937_64 rng(42);
+  constexpr std::size_t n = 100000;
+  const std::array means{0.8954e-10 * UnitConstants::s,
+                         2.617e-10 * UnitConstants::s,
+                         2.617e-10 * UnitConstants::s};
+  for (std::size_t i = 0; i < species.size(); ++i) {
+    Particle parent(Barcode().withParticle(1), species[i]);
+    parent.setProperTime(7_mm).setAbsoluteMomentum(2_GeV);
+    double sum = 0;
+    std::array<std::size_t, 3> survived{};
+    const std::array times{0.5, 1., 2.};
+    for (std::size_t j = 0; j < n; ++j) {
+      const double t =
+          (decay.generateProperTimeLimit(rng, parent) - parent.properTime()) /
+          means[i];
+      sum += t;
+      for (std::size_t k = 0; k < times.size(); ++k) {
+        survived[k] += t > times[k];
+      }
+    }
+    // Six standard errors for exponential mean and binomial survival counts.
+    CHECK_CLOSE_ABS(sum / n, 1., 6 / std::sqrt(n));
+    for (std::size_t k = 0; k < times.size(); ++k) {
+      const double probability = std::exp(-times[k]);
+      CHECK_CLOSE_ABS(static_cast<double>(survived[k]) / n, probability,
+                      6 * std::sqrt(probability * (1 - probability) / n));
+    }
+  }
+}
+
+BOOST_AUTO_TEST_CASE(NativeDecayChannelsAndIsotropy) {
+  NativeDecay decay;
+  std::mt19937_64 rng(781);
+  constexpr std::size_t n = 100000;
+  for (const auto pdg : species) {
+    Particle parent(Barcode().withParticle(1), pdg);
+    std::size_t charged = 0;
+    Vector3 mean = Vector3::Zero(), second = Vector3::Zero();
+    double maxClosure = 0;
+    bool valid = true;
+    for (std::size_t i = 0; i < n; ++i) {
+      const auto daughters = decay.run(rng, parent);
+      const auto& a = daughters[0];
+      const auto& b = daughters[1];
+      charged += a.charge() != 0;
+      maxClosure = std::max(
+          maxClosure,
+          (a.fourMomentum() + b.fourMomentum() - parent.fourMomentum()).norm());
+      valid &= a.charge() + b.charge() == parent.charge();
+      if (pdg == PdgParticle::eKaon0Short) {
+        valid &= (a.pdg() == PdgParticle::ePionPlus &&
+                  b.pdg() == PdgParticle::ePionMinus) ||
+                 (a.pdg() == PdgParticle::ePionZero &&
+                  b.pdg() == PdgParticle::ePionZero);
+      } else {
+        const int sign = pdg > 0 ? 1 : -1;
+        valid &= (a.pdg() == sign * PdgParticle::eProton &&
+                  b.pdg() == sign * PdgParticle::ePionMinus) ||
+                 (a.pdg() == sign * PdgParticle::eNeutron &&
+                  b.pdg() == PdgParticle::ePionZero);
+      }
+      mean += a.direction();
+      second += a.direction().cwiseProduct(a.direction());
+    }
+    BOOST_CHECK(valid);
+    BOOST_CHECK_LT(maxClosure, 1e-12);
+    const double fraction =
+        pdg == PdgParticle::eKaon0Short ? 0.6920 / 0.9989 : 0.641;
+    CHECK_CLOSE_ABS(static_cast<double>(charged) / n, fraction,
+                    6 * std::sqrt(fraction * (1 - fraction) / n));
+    CHECK_CLOSE_ABS(mean / n, Vector3::Zero(), 0.012);
+    CHECK_CLOSE_ABS(second / n, Vector3::Constant(1. / 3), 0.012);
+  }
+}
