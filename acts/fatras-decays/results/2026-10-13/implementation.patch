diff --git a/Fatras/src/Physics/NativeDecay.cpp b/Fatras/src/Physics/NativeDecay.cpp
new file mode 100644
index 0000000000..11248cbd0b
--- /dev/null
+++ b/Fatras/src/Physics/NativeDecay.cpp
@@ -0,0 +1,82 @@
+// This file is part of the ACTS project.
+//
+// Copyright (C) 2016 CERN for the benefit of the ACTS project
+//
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at https://mozilla.org/MPL/2.0/.
+
+#include "ActsFatras/Physics/Decay/NativeDecay.hpp"
+
+#include "Acts/Definitions/Units.hpp"
+#include "ActsFatras/Physics/Decay/TwoBodyDecay.hpp"
+
+#include <array>
+
+namespace ActsFatras {
+
+double NativeDecay::meanProperLifetime(Acts::PdgParticle pdg) {
+  // PDG 2026 listings (CPT fit for K-short; same lifetime for anti-Lambda).
+  // https://pdg.lbl.gov/2026/listings/rpp2026-list-K-zero-S.pdf
+  // https://pdg.lbl.gov/2026/listings/rpp2026-list-lambda.pdf
+  if (pdg == Acts::PdgParticle::ePionZero) {
+    return 0;
+  }
+  if (pdg == Acts::PdgParticle::eKaon0Short) {
+    return 0.8954e-10 * Acts::UnitConstants::s;
+  }
+  if (Acts::makeAbsolutePdgParticle(pdg) == Acts::PdgParticle::eLambda0) {
+    return 2.617e-10 * Acts::UnitConstants::s;
+  }
+  return std::numeric_limits<double>::infinity();
+}
+
+bool NativeDecay::canDecay(const Particle& particle) const {
+  return enabled && particle.isAlive() &&
+         std::isfinite(meanProperLifetime(particle.pdg()));
+}
+
+std::vector<Particle> NativeDecay::daughters(const Particle& parent,
+                                             double channel, double cosTheta,
+                                             double phi) {
+  using enum Acts::PdgParticle;
+  std::array<Acts::PdgParticle, 2> pdgs{eGamma, eGamma};
+  if (parent.pdg() == eKaon0Short) {
+    // Normalize the two dominant PDG 2026 modes (sum = 0.9989).
+    pdgs = channel < 0.6920 / (0.6920 + 0.3069)
+               ? std::array{ePionPlus, ePionMinus}
+               : std::array{ePionZero, ePionZero};
+  } else if (parent.absolutePdg() == eLambda0) {
+    // PDG 2026 ratio Gamma(p pi-)/Gamma(N pi) = 0.641.
+    pdgs = channel < 0.641 ? std::array{eProton, ePionMinus}
+                           : std::array{eNeutron, ePionZero};
+    if (parent.pdg() < 0) {
+      for (auto& pdg : pdgs) {
+        if (pdg != ePionZero) {
+          pdg = static_cast<Acts::PdgParticle>(-pdg);
+        }
+      }
+    }
+  }
+  std::vector<Particle> result;
+  result.reserve(2);
+  for (std::size_t i = 0; i < pdgs.size(); ++i) {
+    result.emplace_back(parent.particleId().makeDescendant(i), pdgs[i]);
+  }
+  const auto momenta =
+      twoBodyDecay(parent.momentum(), parent.mass(),
+                   {result[0].mass(), result[1].mass()}, cosTheta, phi);
+  for (std::size_t i = 0; i < result.size(); ++i) {
+    const double p = momenta[i].norm();
+    result[i]
+        .setPosition4(parent.fourPosition())
+        .setAbsoluteMomentum(p)
+        .setDirection(p > 0 ? Acts::Vector3(momenta[i] / p)
+                            : parent.direction())
+        .setParentParticleId(parent.particleId())
+        .setProcess(GenerationProcess::eDecay);
+  }
+  return result;
+}
+
+}  // namespace ActsFatras
