+namespace ActsFatras {
+namespace {
+void require(bool condition, const char* message) {
+  if (!condition) {
+    throw std::invalid_argument(std::string("NuclearInteractionTable: ") +
+                                message);
+  }
+}
+bool finiteNonnegative(double value) {
+  return std::isfinite(value) && value >= 0;
+}
+bool sameMaterial(double a, double b, double tolerance = 1e-3) {
+  return std::abs(a - b) <= tolerance * std::max(std::abs(a), std::abs(b));
+}
+template <typename T>
+T readValue(std::istream& input) {
+  T value;
+  require(static_cast<bool>(input >> value), "truncated or malformed input");
+  return value;
+}
+std::size_t readCount(std::istream& input) {
+  const auto value = readValue<unsigned long long>(input);
+  require(value <= 1000000, "record count exceeds format limit");
+  return static_cast<std::size_t>(value);
+}
+Acts::Vector3 readMomentum(std::istream& input) {
+  Acts::Vector3 p;
+  for (int i = 0; i < 3; ++i) {
+    p[i] = readValue<double>(input) * Acts::UnitConstants::GeV;
+  }
+  return p;
+}
+}  // namespace
+
+NuclearInteractionTable::NuclearInteractionTable(std::vector<Channel> channels)
+    : m_channels(std::move(channels)) {
+  require(!m_channels.empty(), "empty table");
+  for (std::size_t i = 0; i < m_channels.size(); ++i) {
+    const auto& channel = m_channels[i];
+    require(channel.pdg == Acts::PdgParticle::ePionPlus ||
+                channel.pdg == Acts::PdgParticle::ePionMinus ||
+                channel.pdg == Acts::PdgParticle::eProton,
+            "only charged pions and protons are supported");
+    require(std::isfinite(channel.projectileMass) &&
+                channel.projectileMass > 0 &&
+                std::isfinite(channel.atomicMass) && channel.atomicMass > 0 &&
+                std::isfinite(channel.atomicNumber) && channel.atomicNumber > 0,
+            "invalid channel properties");
+    require(
+        std::abs(channel.projectileMass - Acts::findMass(channel.pdg).value()) <
+            1e-3 * channel.projectileMass,
+        "projectile mass does not match PDG");
+    // Reject overlapping lookup intervals, not just equal material centres.
+    for (std::size_t j = 0; j < i; ++j) {
+      const auto& other = m_channels[j];
+      require(channel.pdg != other.pdg ||
+                  !sameMaterial(channel.atomicMass, other.atomicMass,
+                                2e-3 - 1e-6) ||
+                  !sameMaterial(channel.atomicNumber, other.atomicNumber,
+                                2e-3 - 1e-6),
+              "ambiguous material channels");
+    }
+    require(channel.bins.size() >= 2,
+            "a momentum domain needs at least two nodes");
+    double previous = 0;
+    for (const auto& bin : channel.bins) {
+      require(std::isfinite(bin.momentum) && bin.momentum > previous,
+              "momentum nodes must be positive and strictly increasing");
+      previous = bin.momentum;
+      require(finiteNonnegative(bin.ratePerL0), "invalid interaction rate");
+      require(bin.ratePerL0 == 0 || !bin.events.empty(),
+              "nonzero rate without events");
+      for (const auto& event : bin.events) {
+        require(std::isfinite(event.targetMass) && event.targetMass > 0 &&
+                    finiteNonnegative(event.remnantMass) &&
+                    std::isfinite(event.remnantCharge) &&
+                    event.remnantMomentum.allFinite(),
+                "invalid residual system");
+        double energy =
+            std::hypot(event.remnantMass, event.remnantMomentum.norm());
+        double charge = event.remnantCharge;
+        Acts::Vector3 momentum = event.remnantMomentum;
+        const double rootS =
+            std::sqrt(channel.projectileMass * channel.projectileMass +
+                      event.targetMass * event.targetMass +
+                      2 * event.targetMass *
+                          std::hypot(channel.projectileMass, bin.momentum));
+        for (const auto& product : event.products) {
+          const auto expectedCharge = Acts::findCharge(product.pdg);
+          const auto expectedMass = Acts::findMass(product.pdg);
+          require(expectedCharge.has_value() && expectedMass.has_value() &&
+                      finiteNonnegative(product.mass) &&
+                      std::isfinite(product.charge) &&
+                      product.momentum.allFinite(),
+                  "invalid product");
+          require(std::abs(product.charge - expectedCharge.value()) < 1e-6 &&
+                      std::abs(product.mass - expectedMass.value()) <
+                          1e-3 * std::max(product.mass,
+                                          1e-3 * Acts::UnitConstants::GeV),
+                  "product mass or charge does not match PDG");
+          energy += std::hypot(product.mass, product.momentum.norm());
+          momentum += product.momentum;
+          charge += product.charge;
+        }
+        require(std::abs(energy - rootS) < 1e-6 * rootS &&
+                    momentum.norm() < 1e-6 * rootS,
+                "nonconserving CM four-momentum");
+        require(std::abs(charge - channel.atomicNumber -
+                         Acts::findCharge(channel.pdg).value()) < 1e-6,
+                "nonconserving electric charge");
+      }
+    }
+  }
+}
+
+NuclearInteractionTable NuclearInteractionTable::read(std::istream& input) {
+  require(readValue<std::string>(input) == "ACTS_FATRAS_NUCLEAR_V1",
+          "unknown format version");
+  std::vector<Channel> channels;
+  const auto nChannels = readCount(input);
+  for (std::size_t c = 0; c < nChannels; ++c) {
+    Channel channel;
+    channel.pdg = static_cast<Acts::PdgParticle>(readValue<int>(input));
+    channel.projectileMass =
+        readValue<double>(input) * Acts::UnitConstants::GeV;
+    channel.atomicMass = readValue<double>(input);
+    channel.atomicNumber = readValue<double>(input);
+    const auto nBins = readCount(input);
+    for (std::size_t b = 0; b < nBins; ++b) {
+      MomentumBin bin;
+      bin.momentum = readValue<double>(input) * Acts::UnitConstants::GeV;
+      bin.ratePerL0 = readValue<double>(input);
+      const auto nEvents = readCount(input);
+      for (std::size_t e = 0; e < nEvents; ++e) {
+        Event event;
+        event.targetMass = readValue<double>(input) * Acts::UnitConstants::GeV;
+        event.remnantMass = readValue<double>(input) * Acts::UnitConstants::GeV;
+        event.remnantCharge = readValue<double>(input) * Acts::UnitConstants::e;
+        event.remnantMomentum = readMomentum(input);
+        const auto nProducts = readCount(input);
+        for (std::size_t p = 0; p < nProducts; ++p) {
+          Product product;
+          product.pdg = static_cast<Acts::PdgParticle>(readValue<int>(input));
+          product.mass = readValue<double>(input) * Acts::UnitConstants::GeV;
+          product.charge = readValue<double>(input) * Acts::UnitConstants::e;
+          product.momentum = readMomentum(input);
+          event.products.push_back(std::move(product));
+        }
+        bin.events.push_back(std::move(event));
+      }
+      channel.bins.push_back(std::move(bin));
+    }
+    channels.push_back(std::move(channel));
+  }
+  input >> std::ws;
+  require(input.eof(), "trailing input");
+  return NuclearInteractionTable(std::move(channels));
+}
+
+const NuclearInteractionTable::Channel* NuclearInteractionTable::findChannel(
+    Acts::PdgParticle pdg, const Acts::Material& material) const {
+  for (const auto& channel : m_channels) {
+    if (channel.pdg == pdg && sameMaterial(channel.atomicMass, material.Ar()) &&
+        sameMaterial(channel.atomicNumber, material.Z())) {
+      return &channel;
+    }
+  }
+  return nullptr;
+}
+
+const NuclearInteractionTable::MomentumBin* NuclearInteractionTable::findBin(
+    const Channel& channel, double momentum) {
+  if (!std::isfinite(momentum) || momentum < channel.bins.front().momentum ||
+      momentum > channel.bins.back().momentum) {
+    return nullptr;
+  }
+  const auto upper = std::upper_bound(
+      channel.bins.begin(), channel.bins.end(), momentum,
+      [](double p, const MomentumBin& bin) { return p < bin.momentum; });
+  return &*std::prev(upper);
+}
+
+NuclearInteractionTable::Sample NuclearInteractionTable::sample(
+    const Event& event, const Particle& projectile, double azimuth) {
+  if (event.products.empty()) {
+    // Complete absorption: excitation of the residual system carries any
+    // difference from the tabulated collision energy.
+    Sample result;
+    result.targetMass = event.targetMass;
+    result.remnantCharge = event.remnantCharge;
+    result.remnant = projectile.fourMomentum();
+    result.remnant[3] += event.targetMass;
+    return result;
+  }
+  const double rootS = std::sqrt(projectile.mass() * projectile.mass() +
+                                 event.targetMass * event.targetMass +
+                                 2 * event.targetMass * projectile.energy());
+  const auto energy = [&](double scale) {
+    double sum =
+        std::hypot(event.remnantMass, scale * event.remnantMomentum.norm());
+    for (const auto& product : event.products) {
+      sum += std::hypot(product.mass, scale * product.momentum.norm());
+    }
+    return sum;
+  };
+  require(energy(0) <= rootS, "sample below final-state mass threshold");
+  double lo = 0, hi = 1;
+  for (unsigned int i = 0; energy(hi) < rootS; ++i) {
+    require(i < 64, "cannot rescale zero-momentum final state");
+    hi *= 2;
+  }
+  for (unsigned int i = 0; i < 48; ++i) {
+    const double middle = 0.5 * (lo + hi);
+    if (energy(middle) < rootS) {
+      lo = middle;
+    } else {
+      hi = middle;
+    }
+  }
+  const double scale = 0.5 * (lo + hi);
+  const auto& z = projectile.direction();
+  const Acts::Vector3 u = Acts::createCurvilinearUnitU(z);
+  const Acts::Vector3 v = z.cross(u);
+  const Acts::Vector3 x = std::cos(azimuth) * u + std::sin(azimuth) * v;
+  const Acts::Vector3 y = -std::sin(azimuth) * u + std::cos(azimuth) * v;
+  const double gamma = (projectile.energy() + event.targetMass) / rootS;
+  const double betaGamma = projectile.absoluteMomentum() / rootS;
+  const auto boost = [&](const Acts::Vector3& momentum, double mass) {
+    const Acts::Vector3 q = scale * momentum;
+    const double e = std::hypot(mass, q.norm());
+    Acts::Vector4 out;
+    out.head<3>() = q.x() * x + q.y() * y + (gamma * q.z() + betaGamma * e) * z;
+    out[3] = gamma * e + betaGamma * q.z();
+    return out;
+  };
+  Sample result;
+  result.targetMass = event.targetMass;
+  result.remnantCharge = event.remnantCharge;
+  result.remnant = boost(event.remnantMomentum, event.remnantMass);
+  for (const auto& product : event.products) {
+    result.products.push_back(product);
+    result.products.back().momentum =
+        boost(product.momentum, product.mass).head<3>();
+  }
+  return result;
+}
+}  // namespace ActsFatras
