+// This file is part of the ACTS project.
+//
+// Copyright (C) 2016 CERN for the benefit of the ACTS project
+//
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at https://mozilla.org/MPL/2.0/.
+
+#include "ActsFatras/Physics/Hadronic/NuclearInteraction.hpp"
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+
+namespace ActsFatras {
+std::array<NuclearInteractionTable::Product, 2> NuclearInteraction::decayPi0(
+    const NuclearInteractionTable::Product& pion, double cosTheta, double phi) {
+  const double sinTheta = std::sqrt(std::max(0., 1 - cosTheta * cosTheta));
+  const Acts::Vector3 q = 0.5 * pion.mass *
+                          Acts::Vector3(sinTheta * std::cos(phi),
+                                        sinTheta * std::sin(phi), cosTheta);
+  const double energy = std::hypot(pion.mass, pion.momentum.norm());
+  const double gamma = energy / pion.mass;
+  const Acts::Vector3 beta = pion.momentum / energy;
+  std::array<NuclearInteractionTable::Product, 2> photons;
+  for (std::size_t i = 0; i < photons.size(); ++i) {
+    const Acts::Vector3 rest = i == 0 ? q : Acts::Vector3(-q);
+    photons[i].pdg = Acts::PdgParticle::eGamma;
+    photons[i].momentum =
+        rest + beta * (gamma * gamma / (gamma + 1) * beta.dot(rest) +
+                       gamma * pion.mass * 0.5);
+  }
+  return photons;
+}
+
+void NuclearInteraction::append(const Particle& parent,
+                                const NuclearInteractionTable::Product& product,
+                                std::size_t index,
+                                std::vector<Particle>& generated) {
+  generated.emplace_back(parent.particleId().makeDescendant(index), product.pdg,
+                         product.charge, product.mass);
+  generated.back()
+      .setPosition4(parent.fourPosition())
+      .setAbsoluteMomentum(product.momentum.norm())
+      .setDirection(product.momentum.norm() > 0
+                        ? Acts::Vector3(product.momentum.normalized())
+                        : parent.direction())
+      .setProcess(GenerationProcess::eNuclearInteraction);
+}
+}  // namespace ActsFatras
