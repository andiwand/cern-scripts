+// This file is part of the ACTS project.
+//
+// Copyright (C) 2016 CERN for the benefit of the ACTS project
+//
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at https://mozilla.org/MPL/2.0/.
+
+#pragma once
+
+#include "Acts/Definitions/Algebra.hpp"
+#include "Acts/Definitions/PdgParticle.hpp"
+#include "Acts/Material/Material.hpp"
+#include "ActsFatras/EventData/Particle.hpp"
+
+#include <iosfwd>
+#include <vector>
+
+namespace ActsFatras {
+
+/// Immutable library of correlated hadron-nucleus final states.
+///
+/// Entries are indexed by projectile PDG, material Ar/Z and momentum. Each
+/// event includes a target mass and a residual system, so conservation applies
+/// to projectile plus target, not the projectile alone. Momenta are stored in
+/// the centre-of-mass frame, with the incident projectile along +z.
+class NuclearInteractionTable {
+ public:
+  /// An on-shell outgoing particle, using native ACTS units.
+  struct Product {
+    Acts::PdgParticle pdg = Acts::PdgParticle::eInvalid;
+    double mass = 0;
+    double charge = 0;
+    Acts::Vector3 momentum = Acts::Vector3::Zero();
+  };
+  /// One complete interaction. The residual system is not transported.
+  struct Event {
+    double targetMass = 0;
+    double remnantMass = 0;
+    double remnantCharge = 0;
+    Acts::Vector3 remnantMomentum = Acts::Vector3::Zero();
+    std::vector<Product> products;
+  };
+  /// Cross section relative to the material's tabulated nuclear length.
+  struct MomentumBin {
+    double momentum = 0;
+    double ratePerL0 = 0;
+    std::vector<Event> events;
+  };
+  /// Calibration for a single projectile species and material composition.
+  struct Channel {
+    Acts::PdgParticle pdg = Acts::PdgParticle::eInvalid;
+    double projectileMass = 0;
+    double atomicMass = 0;
+    double atomicNumber = 0;
+    std::vector<MomentumBin> bins;
+  };
+  /// A sampled event transformed to the laboratory frame.
+  struct Sample {
+    std::vector<Product> products;
+    Acts::Vector4 remnant = Acts::Vector4::Zero();
+    double remnantCharge = 0;
+    double targetMass = 0;
+  };
+
+  /// Validate and take ownership of the calibration. Throws invalid_argument
+  /// for invalid values, unsupported projectiles or nonconserving events.
+  explicit NuclearInteractionTable(std::vector<Channel> channels);
+
+  /// Read the versioned text format documented in
+  /// docs/pages/fatras_hadronic.md. Energies/momenta in that format are GeV and
+  /// charges are in e. Throws invalid_argument for malformed or inconsistent
+  /// input.
+  static NuclearInteractionTable read(std::istream& input);
+
+  /// Read-only access, also useful for calibration validation.
+  const std::vector<Channel>& channels() const { return m_channels; }
+
+  /// Match material Ar/Z to relative tolerance 1e-3; no nearest-element
+  /// fallback.
+  const Channel* findChannel(Acts::PdgParticle pdg,
+                             const Acts::Material& material) const;
+
+  /// Return the lower momentum node, with no extrapolation outside the grid.
+  /// Final-state shapes are piecewise constant; the process interpolates rates.
+  static const MomentumBin* findBin(const Channel& channel, double momentum);
+
+  /// Rescale all CM momenta by one factor to match the actual collision energy,
+  /// preserving directions and momentum balance. Rotate by azimuth and boost
+  /// along the incident particle. Includes the remnant in the energy equation.
+  static Sample sample(const Event& event, const Particle& projectile,
+                       double azimuth);
+
+ private:
+  std::vector<Channel> m_channels;
+};
+
+}  // namespace ActsFatras
