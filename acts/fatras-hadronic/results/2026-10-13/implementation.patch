+BOOST_AUTO_TEST_CASE(ConservationAtAndBetweenMomentumNodes) {
+  const Table table({makeChannel()});
+  for (double p : {1_GeV, 1.2_GeV, 2_GeV}) {
+    const auto particle = pion(p);
+    const auto& channel = table.channels()[0];
+    const auto* bin = Table::findBin(channel, p);
+    BOOST_REQUIRE(bin);
+    const auto sample = Table::sample(bin->events[0], particle, 0.7);
+    Acts::Vector4 sum = sample.remnant;
+    double charge = sample.remnantCharge;
+    for (const auto& product : sample.products) {
+      sum += fourMomentum(product);
+      charge += product.charge;
+    }
+    auto expected = particle.fourMomentum();
+    expected[3] += sample.targetMass;
+    BOOST_CHECK_SMALL((sum - expected).norm(), 1e-10);
+    BOOST_CHECK_CLOSE(charge, 15., 1e-10);
+  }
+}
+
+BOOST_AUTO_TEST_CASE(ProbabilityAndSplitSlabSurvival) {
+  auto channel = makeChannel();
+  channel.bins.back().ratePerL0 = 3;
+  NuclearInteraction process{std::make_shared<Table>(std::vector{channel})};
+  constexpr int trials = 40000;
+  // At 1.5 GeV the rate interpolates to two interactions per nuclear length.
+  const double expected = 1 - std::exp(-0.6);
+  for (int splits : {1, 2}) {
+    std::ranlux48 rng(456);
+    int interactions = 0;
+    for (int i = 0; i < trials; ++i) {
+      auto particle = pion();
+      std::vector<Particle> products;
+      for (int part = 0; part < splits; ++part) {
+        if (process(rng, slab(0.3 / splits), particle, products)) {
+          ++interactions;
+          break;
+        }
+      }
+    }
+    BOOST_CHECK_SMALL(static_cast<double>(interactions) / trials - expected,
+                      0.008);
+  }
+}
+
+BOOST_AUTO_TEST_CASE(PromptPi0DecayReplayAndParentTermination) {
+  NuclearInteraction process{
+      std::make_shared<Table>(std::vector{makeChannel()})};
+  auto particle = pion();
+  const auto original = particle;
+  std::ranlux48 a(42), b(42);
+  std::vector<Particle> first, second;
+  BOOST_REQUIRE(process(a, slab(100), particle, first));
+  auto repeated = original;
+  BOOST_REQUIRE(process(b, slab(100), repeated, second));
+  BOOST_REQUIRE_EQUAL(first.size(), 3u);
+  BOOST_CHECK_EQUAL(first[1].pdg(), Acts::PdgParticle::eGamma);
+  BOOST_CHECK_EQUAL(first[2].pdg(), Acts::PdgParticle::eGamma);
+  const auto photons = first[1].fourMomentum() + first[2].fourMomentum();
+  const double m = Acts::findMass(Acts::PdgParticle::ePionZero).value();
+  BOOST_CHECK_SMALL(
+      photons[3] * photons[3] - photons.head<3>().squaredNorm() - m * m, 1e-12);
+  for (std::size_t i = 0; i < first.size(); ++i) {
+    BOOST_CHECK_EQUAL(first[i].fourMomentum(), second[i].fourMomentum());
+    BOOST_CHECK_EQUAL(first[i].fourPosition(), particle.fourPosition());
+    BOOST_CHECK_EQUAL(first[i].particleId(),
+                      particle.particleId().makeDescendant(i));
+    BOOST_CHECK(first[i].process() == GenerationProcess::eNuclearInteraction);
+  }
+  BOOST_CHECK_EQUAL(particle.fourMomentum(), original.fourMomentum());
+  BOOST_CHECK(particle.outcome() == SimulationOutcome::KilledInteraction);
+}
+
+BOOST_AUTO_TEST_CASE(UnsupportedInputsDoNotConsumeRandomNumbers) {
+  NuclearInteraction process{
+      std::make_shared<Table>(std::vector{makeChannel()})};
+  std::ranlux48 rng(123), before = rng;
+  std::vector<Particle> products;
+  auto particle = pion(0.5_GeV);
+  BOOST_CHECK(!process(rng, slab(1), particle, products));
+  particle = pion(3_GeV);
+  BOOST_CHECK(!process(rng, slab(1), particle, products));
+  particle = pion();
+  BOOST_CHECK(!process(rng, Acts::MaterialSlab(), particle, products));
+  BOOST_CHECK(!process(rng, slab(0), particle, products));
+  const Acts::MaterialSlab carbon(
+      Acts::Material::fromMolarDensity(1, 1, 12, 6, 1), 1);
+  BOOST_CHECK(!process(rng, carbon, particle, products));
+  auto muon = Particle(Barcode().withParticle(2), Acts::PdgParticle::eMuon)
+                  .setAbsoluteMomentum(1.5);
+  BOOST_CHECK(!process(rng, slab(1), muon, products));
+  process.table.reset();
+  BOOST_CHECK(!process(rng, slab(1), particle, products));
+  BOOST_CHECK(rng == before);
+  BOOST_CHECK(products.empty());
+}
+
+BOOST_AUTO_TEST_CASE(TableValidationAndLoading) {
+  const auto channel = makeChannel();
+  std::istringstream encoded(encode(channel));
+  const auto loaded = Table::read(encoded);
+  BOOST_REQUIRE_EQUAL(loaded.channels().size(), 1u);
+  BOOST_CHECK(loaded.findChannel(channel.pdg, slab(1).material()) != nullptr);
+  auto bad = channel;
+  bad.bins[0].events[0].remnantMomentum.x() = 1;
+  BOOST_CHECK_THROW(Table({bad}), std::invalid_argument);
+  bad = channel;
+  bad.bins[0].events[0].remnantCharge = 13;
+  BOOST_CHECK_THROW(Table({bad}), std::invalid_argument);
+  bad = channel;
+  bad.bins[0].ratePerL0 = -1;
+  BOOST_CHECK_THROW(Table({bad}), std::invalid_argument);
+  bad = channel;
+  bad.bins[0].events.clear();
+  BOOST_CHECK_THROW(Table({bad}), std::invalid_argument);
+  bad = channel;
+  bad.bins[1].momentum = bad.bins[0].momentum;
+  BOOST_CHECK_THROW(Table({bad}), std::invalid_argument);
+  BOOST_CHECK_THROW(Table((std::vector{channel, channel})),
+                    std::invalid_argument);
+  bad = channel;
+  bad.atomicMass *= 1.0015;
+  BOOST_CHECK_THROW(Table((std::vector{channel, bad})), std::invalid_argument);
+  for (const std::string& text : std::vector<std::string>{
+           "ACTS_FATRAS_NUCLEAR_V2 0", "ACTS_FATRAS_NUCLEAR_V1 1",
+           encode(channel) + "garbage"}) {
+    std::istringstream input(text);
+    BOOST_CHECK_THROW(Table::read(input), std::invalid_argument);
+  }
+}
+
+BOOST_AUTO_TEST_CASE(CompleteAbsorptionConservesIncomingFourMomentum) {
+  auto channel = makeChannel();
+  for (auto& bin : channel.bins) {
+    auto& event = bin.events.front();
+    event.products.clear();
+    event.remnantMomentum.setZero();
+    event.remnantCharge = 15;
+    event.remnantMass =
+        std::sqrt(channel.projectileMass * channel.projectileMass +
+                  event.targetMass * event.targetMass +
+                  2 * event.targetMass *
+                      std::hypot(channel.projectileMass, bin.momentum));
+  }
+  Table table({channel});
+  const auto particle = pion();
+  const auto sampled = table.sample(channel.bins[0].events[0], particle, 0);
+  auto expected = particle.fourMomentum();
+  expected[3] += sampled.targetMass;
+  BOOST_CHECK_EQUAL(sampled.remnant, expected);
+  BOOST_CHECK(sampled.products.empty());
+}
