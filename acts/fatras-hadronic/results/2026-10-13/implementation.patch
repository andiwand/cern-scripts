new file mode 100644
index 0000000000..c4284b649f
--- /dev/null
+++ b/Fatras/include/ActsFatras/Physics/Hadronic/NuclearInteraction.hpp
@@ -0,0 +1,96 @@
+// This file is part of the ACTS project.
+//
+// Copyright (C) 2016 CERN for the benefit of the ACTS project
+//
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at https://mozilla.org/MPL/2.0/.
+
+#pragma once
+
+#include "Acts/Material/MaterialSlab.hpp"
+#include "ActsFatras/EventData/GenerationProcess.hpp"
+#include "ActsFatras/Physics/Hadronic/NuclearInteractionTable.hpp"
+
+#include <array>
+#include <cmath>
+#include <memory>
+#include <numbers>
+#include <random>
+#include <vector>
+
+namespace ActsFatras {
+
+/// Opt-in, surface-local inelastic interactions of charged pions and protons.
+///
+/// Uses the material-aware surface-process interface. Survival through a slab
+/// is exp(-ratePerL0 * thicknessInL0), including across split slabs. The vertex
+/// is placed on the surface and all incoming EM effects precede this process.
+/// This is a thin-slab approximation, not longitudinal shower transport.
+/// Unsupported species, materials and momenta pass through without consuming
+/// random numbers. A null table disables the process.
+struct NuclearInteraction {
+  std::shared_ptr<const NuclearInteractionTable> table;
+
+  /// Sample the interaction and append its daughters. Return true to terminate
+  /// the incident particle, retaining its kinematics for truth bookkeeping.
+  /// Prompt pi0 -> gamma gamma is included; its intermediate vertex is folded
+  /// into the nuclear vertex and the photons carry eNuclearInteraction.
+  template <typename generator_t>
+  bool operator()(generator_t& generator, const Acts::MaterialSlab& slab,
+                  Particle& particle, std::vector<Particle>& generated) const {
+    if (!table || !particle.isAlive() || slab.isVacuum() ||
+        slab.thicknessInL0() <= 0) {
+      return false;
+    }
+    const auto* channel = table->findChannel(particle.pdg(), slab.material());
+    if (channel == nullptr) {
+      return false;
+    }
+    const auto* bin = table->findBin(*channel, particle.absoluteMomentum());
+    if (bin == nullptr || bin->ratePerL0 == 0) {
+      return false;
+    }
+    double rate = bin->ratePerL0;
+    if (bin != &channel->bins.back()) {
+      const auto& next = *(bin + 1);
+      const double weight = (particle.absoluteMomentum() - bin->momentum) /
+                            (next.momentum - bin->momentum);
+      rate = std::lerp(rate, next.ratePerL0, weight);
+    }
+    std::uniform_real_distribution<double> uniform(0, 1);
+    const double probability = -std::expm1(-rate * slab.thicknessInL0());
+    if (uniform(generator) >= probability) {
+      return false;
+    }
+    std::uniform_int_distribution<std::size_t> index(0, bin->events.size() - 1);
+    const auto& event = bin->events[index(generator)];
+    auto sample = table->sample(event, particle,
+                                2 * std::numbers::pi * uniform(generator));
+    std::size_t childIndex = 0;
+    for (const auto& product : sample.products) {
+      if (product.pdg == Acts::PdgParticle::ePionZero) {
+        // Draw angles explicitly in sequence for reproducible RNG consumption.
+        const double cosTheta = 2 * uniform(generator) - 1;
+        const double phi = 2 * std::numbers::pi * uniform(generator);
+        for (const auto& photon : decayPi0(product, cosTheta, phi)) {
+          append(particle, photon, childIndex++, generated);
+        }
+      } else {
+        append(particle, product, childIndex++, generated);
+      }
+    }
+    particle.killParticle(SimulationOutcome::KilledInteraction);
+    return true;
+  }
+
+ private:
+  static std::array<NuclearInteractionTable::Product, 2> decayPi0(
+      const NuclearInteractionTable::Product& pion, double cosTheta,
+      double phi);
+  static void append(const Particle& parent,
+                     const NuclearInteractionTable::Product& product,
+                     std::size_t index, std::vector<Particle>& generated);
+};
+
+}  // namespace ActsFatras
