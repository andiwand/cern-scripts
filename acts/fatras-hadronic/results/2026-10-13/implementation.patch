+namespace {
+using Table = NuclearInteractionTable;
+Table::Channel makeChannel() {
+  Table::Channel channel;
+  channel.pdg = Acts::PdgParticle::ePionPlus;
+  channel.projectileMass = Acts::findMass(channel.pdg).value();
+  channel.atomicMass = 28.0855;
+  channel.atomicNumber = 14;
+  const double neutralMass =
+      Acts::findMass(Acts::PdgParticle::ePionZero).value();
+  for (const double p : {1_GeV, 2_GeV}) {
+    Table::Event event;
+    event.targetMass = event.remnantMass = 26_GeV;
+    event.remnantCharge = 14;
+    const double rootS =
+        std::sqrt(channel.projectileMass * channel.projectileMass +
+                  event.targetMass * event.targetMass +
+                  2 * event.targetMass * std::hypot(channel.projectileMass, p));
+    const double e = rootS - event.remnantMass;
+    const double sum = channel.projectileMass + neutralMass;
+    const double diff = channel.projectileMass - neutralMass;
+    const double q =
+        std::sqrt((e * e - sum * sum) * (e * e - diff * diff)) / (2 * e);
+    event.products.push_back(
+        {channel.pdg, channel.projectileMass, 1, {q, 0, 0}});
+    event.products.push_back(
+        {Acts::PdgParticle::ePionZero, neutralMass, 0, {-q, 0, 0}});
+    channel.bins.push_back({p, 1., {event}});
+  }
+  return channel;
+}
+Acts::MaterialSlab slab(double fraction) {
+  return Acts::MaterialSlab(
+      Acts::Material::fromMolarDensity(10_mm, 20_mm, 28.0855f, 14.f, 1.f),
+      fraction * 20_mm);
+}
+Particle pion(double p = 1.5_GeV) {
+  return Particle(Barcode().withParticle(1), Acts::PdgParticle::ePionPlus)
+      .setAbsoluteMomentum(p)
+      .setDirection(1, 2, 3)
+      .setPosition4(1, 2, 3, 4);
+}
+Acts::Vector4 fourMomentum(const Table::Product& product) {
+  Acts::Vector4 p;
+  p.head<3>() = product.momentum;
+  p[3] = std::hypot(product.mass, product.momentum.norm());
+  return p;
+}
+std::string encode(const Table::Channel& channel) {
+  std::ostringstream out;
+  out << std::setprecision(17) << "ACTS_FATRAS_NUCLEAR_V1\n1\n"
+      << static_cast<int>(channel.pdg) << ' ' << channel.projectileMass << ' '
+      << channel.atomicMass << ' ' << channel.atomicNumber << ' '
+      << channel.bins.size() << '\n';
+  for (const auto& bin : channel.bins) {
+    out << bin.momentum << ' ' << bin.ratePerL0 << ' ' << bin.events.size()
+        << '\n';
+    for (const auto& event : bin.events) {
+      out << event.targetMass << ' ' << event.remnantMass << ' '
+          << event.remnantCharge << ' ' << event.remnantMomentum.transpose()
+          << ' ' << event.products.size() << '\n';
+      for (const auto& product : event.products)
+        out << static_cast<int>(product.pdg) << ' ' << product.mass << ' '
+            << product.charge << ' ' << product.momentum.transpose() << '\n';
+    }
+  }
+  return out.str();
+}
