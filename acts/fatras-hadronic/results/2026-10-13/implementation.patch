+struct FixedLifetimeDecay {
+  double lifetime = 1_um;
+
+  template <typename generator_t>
+  double generateProperTimeLimit(generator_t&, const Particle& particle) const {
+    return particle.properTime() + lifetime;
+  }
+
+  template <typename generator_t>
+  std::array<Particle, 1> run(generator_t& generator,
+                              const Particle& parent) const {
+    static_cast<void>(generator());
+    return {parent.withParticleId(parent.particleId().makeDescendant())};
+  }
+};
+
+}  // namespace
+
+BOOST_AUTO_TEST_CASE(DecayBeforeFirstSurface) {
+  auto geoCtx = GeometryContext::dangerouslyDefaultConstruct();
+  MagneticFieldContext magCtx;
+  CylindricalTrackingGeometry geoBuilder(geoCtx);
+  auto geometry = geoBuilder();
+  using Simulation =
+      SingleParticleSimulation<NeutralPropagator, InteractionList<>, NoSurface,
+                               FixedLifetimeDecay>;
+  Simulation simulation(
+      NeutralPropagator(NeutralStepper(), Navigator({geometry})),
+      getDefaultLogger("Decay", Logging::WARNING));
+  simulation.maxStepSize = 1_m;
+  simulation.pathLimit = 10_m;
+  Generator generator(42);
+  Particle particle(Barcode().withParticle(1), PdgParticle::ePionZero);
+  particle.setDirection(1, 0, 0).setAbsoluteMomentum(1_GeV).setProperTime(2_mm);
+  const auto result = simulation.simulate(geoCtx, magCtx, generator, particle);
+  BOOST_REQUIRE(result.ok());
+  BOOST_CHECK(!result->isAlive);
+  BOOST_REQUIRE_EQUAL(result->generatedParticles.size(), 1u);
+  const double distance =
+      simulation.decay.lifetime * particle.absoluteMomentum() / particle.mass();
+  CHECK_CLOSE_ABS(result->particle.position(), Vector3(distance, 0, 0), 1e-9);
+  CHECK_CLOSE_ABS(result->particle.properTime(),
+                  particle.properTime() + simulation.decay.lifetime, 1e-9);
+  BOOST_CHECK_EQUAL(result->generatedParticles.front().fourPosition(),
+                    result->particle.fourPosition());
+  BOOST_CHECK(result->hits.empty());
+}
+
+BOOST_AUTO_TEST_CASE(NuclearDaughtersProduceHitsAndTerminateParent) {
+  auto geoCtx = GeometryContext::dangerouslyDefaultConstruct();
+  MagneticFieldContext magCtx;
+  CylindricalTrackingGeometry geoBuilder(geoCtx);
+  auto geometry = geoBuilder();
+  auto field = std::make_shared<ConstantBField>(Vector3(0, 0, 2_T));
+  using CS =
+      SingleParticleSimulation<ChargedPropagator, StandardChargedInteractions,
+                               EverySurface, NoDecay>;
+  MultiParticleSimulation<EveryParticle, CS, EveryParticle, NeutralSimulation>
+      simulation(
+          CS(ChargedPropagator(ChargedStepper(field), Navigator({geometry})),
+             getDefaultLogger("Hadronic", Logging::WARNING)),
+          NeutralSimulation(
+              NeutralPropagator(NeutralStepper(), Navigator({geometry})),
+              getDefaultLogger("Neutral", Logging::WARNING)));
+  // Analytic toy reaction: pion + nucleus -> pion + excited residual system.
+  // A deliberately large rate makes this a transport regression, not a physics
+  // tune.
+  NuclearInteractionTable::Channel channel;
+  channel.pdg = PdgParticle::ePionPlus;
+  channel.projectileMass = findMass(channel.pdg).value();
+  channel.atomicMass = 28.0855;
+  channel.atomicNumber = 14;
+  for (double p : {0.5_GeV, 2_GeV}) {
+    NuclearInteractionTable::Event event;
+    event.targetMass = 26_GeV;
+    event.remnantMass = 26.1_GeV;
+    event.remnantCharge = 14;
+    const double m = channel.projectileMass;
+    const double s = m * m + event.targetMass * event.targetMass +
+                     2 * event.targetMass * std::hypot(p, m);
+    const double sum = m + event.remnantMass;
+    const double diff = m - event.remnantMass;
+    const double q = std::sqrt((s - sum * sum) * (s - diff * diff) / (4 * s));
+    event.products.push_back({channel.pdg, m, 1, {0, 0, q}});
+    event.remnantMomentum = Vector3(0, 0, -q);
+    channel.bins.push_back({p, 1e6, {event}});
+  }
+  auto table = std::make_shared<NuclearInteractionTable>(std::vector{channel});
+  simulation.charged.interactions =
+      makeStandardChargedInteractions(0.1_GeV, table);
+  simulation.charged.maxStepSize = 1_m;
+  simulation.charged.pathLimit = 10_m;
+  std::vector<Particle> input{
+      Particle(Barcode().withParticle(1), PdgParticle::ePionPlus)
+          .setAbsoluteMomentum(1_GeV)
+          .setDirection(1, 0, 0)};
+  std::vector<Particle> initial, final;
+  std::vector<Hit> hits;
+  Generator rng(42);
+  const auto result =
+      simulation.simulate(geoCtx, magCtx, rng, input, initial, final, hits);
+  BOOST_REQUIRE(result.ok());
+  BOOST_REQUIRE(result->empty());
+  BOOST_REQUIRE_GT(initial.size(), 1u);
+  BOOST_CHECK(final.front().outcome() == SimulationOutcome::KilledInteraction);
+  BOOST_CHECK_GT(final.front().absoluteMomentum(), 0);
+  const auto secondaries = std::count_if(
+      hits.begin(), hits.end(),
+      [](const auto& hit) { return hit.particleId().generation() > 0; });
+  BOOST_CHECK_GT(secondaries, 0);
+  sortByParticleId(initial);
+  BOOST_CHECK(areParticleIdsUnique(initial));
+  for (const auto& hit : hits) {
+    BOOST_CHECK(containsParticleId(initial, hit));
+  }
+}
